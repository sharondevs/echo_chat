{
  "openapi": "3.0.1",
  "info": {
    "title": "Echo-CHAT RAG API",
    "description": "A scalable RAG (Retrieval-Augmented Generation) application with streaming chat and document querying capabilities. This API provides intelligent document analysis and conversational AI features.",
    "version": "1.0.0",
    "contact": {
      "name": "Echo-CHAT API Support",
      "email": "support@echo-chat.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://your-apim-instance.azure-api.net/echo-chat",
      "description": "Azure API Management Production"
    },
    {
      "url": "https://your-function-app.azurewebsites.net",
      "description": "Azure Functions Backend (Direct)"
    }
  ],
  "paths": {
    "/echo-chat": {
      "get": {
        "operationId": "getHealthStatus",
        "summary": "Health check and service information",
        "description": "Returns the health status of the service and available query modes",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/echo-chat/stream-chat": {
      "post": {
        "operationId": "streamChat",
        "summary": "Streaming chat with RAG capabilities",
        "description": "Send a message and receive streaming responses with context from uploaded documents or resume analysis",
        "tags": ["Chat"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming chat response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "format": "text/event-stream"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/echo-chat/upload": {
      "post": {
        "operationId": "uploadDocuments",
        "summary": "Upload documents for analysis",
        "description": "Upload PDF, TXT, or DOCX files for document analysis and querying",
        "tags": ["Documents"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Documents uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid file type or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/echo-chat/session/{sessionId}": {
      "get": {
        "operationId": "getSessionInfo",
        "summary": "Get session information",
        "description": "Retrieve information about a specific session including uploaded documents",
        "tags": ["Sessions"],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Session ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Session information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cleanupSession",
        "summary": "Clean up session data",
        "description": "Remove all data associated with a session including uploaded documents",
        "tags": ["Sessions"],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Session ID to clean up"
          }
        ],
        "responses": {
          "200": {
            "description": "Session cleaned up successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/echo-chat/modes": {
      "get": {
        "operationId": "getAvailableModes",
        "summary": "Get available query modes",
        "description": "Retrieve list of available query modes for the chat API",
        "tags": ["Configuration"],
        "responses": {
          "200": {
            "description": "Available query modes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "modes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["documents", "resume"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Simple health check",
        "description": "Basic health check endpoint for monitoring and load balancers",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["message", "mode"],
        "properties": {
          "message": {
            "type": "string",
            "description": "The chat message or question to ask",
            "example": "What is the main topic of the uploaded document?"
          },
          "mode": {
            "type": "string",
            "enum": ["documents", "resume"],
            "description": "Query mode - either 'documents' or 'resume'"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "Session ID for document context (required for documents mode)",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        }
      },
      "DocumentUploadRequest": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            },
            "description": "Files to upload (PDF, TXT, DOCX supported)"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional session ID (will be generated if not provided)"
          }
        }
      },
      "DocumentUploadResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Successfully processed 3 documents"
          },
          "file_count": {
            "type": "integer",
            "example": 3
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "modes_available": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["documents", "resume"]
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "string",
            "description": "Additional error details"
          },
          "request_id": {
            "type": "string",
            "description": "Request tracking ID"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "Ocp-Apim-Subscription-Key",
        "in": "header",
        "description": "API Management subscription key"
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "name": "subscription-key",
        "in": "query",
        "description": "API Management subscription key in query parameter"
      }
    }
  },
  "security": [
    {
      "apiKeyHeader": []
    },
    {
      "apiKeyQuery": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check and service status endpoints"
    },
    {
      "name": "Chat",
      "description": "Streaming chat and RAG query endpoints"
    },
    {
      "name": "Documents",
      "description": "Document upload and management endpoints"
    },
    {
      "name": "Sessions",
      "description": "Session management and information endpoints"
    },
    {
      "name": "Configuration",
      "description": "Service configuration and capabilities endpoints"
    }
  ]
} 